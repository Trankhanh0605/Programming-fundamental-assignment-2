{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-debug",
      "type": "shell",
      "command": "g++",                        // hoặc "gcc" nếu file .c
      "args": [
        "-g",                                  // sinh debug symbols
        "${file}",                             // file hiện tại (hcmcampaign.cpp)
        "-o",
        "${fileBasenameNoExtension}"           // output: hcmcampaign
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}

