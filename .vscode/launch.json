{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
      "name": "Debug hcmcampaign",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/${fileBasenameNoExtension}",  
      "args": [],                        
      "stopAtEntry": false,              // nếu true sẽ dừng ngay hàm main
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,          // dùng tích hợp trong VS Code
      "MIMode": "gdb",
      "miDebuggerPath": "/opt/homebrew/bin/gdb",  
      "preLaunchTask": "build-debug",   // tự động build trước khi debug
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]

      
}